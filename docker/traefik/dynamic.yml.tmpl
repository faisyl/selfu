# Traefik dynamic configuration (rendered from this template; env from compose).
http:
  routers:
    platform:
      rule: "Host(`{{ env "PLATFORM_HOST" }}`)"
      service: platform
      tls:
        certResolver: le
    authentik:
      rule: "Host(`{{ env "AUTH_HOST" }}`)"
      service: authentik
      tls:
        certResolver: le
    # Bootstrap catch-all: serves the platform wizard for any host
    # (raw IP / no DNS yet — first-run onboarding). Specific Host
    # rules above take precedence over this rule.
    bootstrap:
      rule: "Host(`*`)"
      service: platform
      tls: {}
  services:
    platform:
      loadBalancer:
        servers:
          - url: "http://api:8080"
    authentik:
      loadBalancer:
        servers:
          - url: "http://authentik-server:9000"