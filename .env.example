# Copy to .env and generate real secrets (see Makefile target gen-env):
#   cp .env.example .env && make gen-env
# Never commit .env.

# PostgreSQL (shared instance, two databases: selfu, authentik)
POSTGRES_USER=selfu
POSTGRES_PASSWORD=change-me

# authentik (identity provider)
AUTHENTIK_HOST=http://localhost:9000
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_BOOTSTRAP_EMAIL=admin@selfu.local
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me
AUTHENTIK_BOOTSTRAP_TOKEN=change-me

# Platform API
SELFU_SESSION_SECRET=change-me-at-least-32-bytes
SELFU_OIDC_CLIENT_ID=selfu
SELFU_OIDC_CLIENT_SECRET=change-me
SELFU_OIDC_REDIRECT_URL=http://localhost:18080/api/v1/auth/callback
# Issuer of the platform OIDC provider inside authentik.
SELFU_OIDC_ISSUER_PATH=/application/o/selfu/
SELFU_AUTHENTIK_URL=http://localhost:9000
SELFU_AUTHENTIK_TOKEN=change-me-service-token
CHASQUID_AGENT_TOKEN=change-me

# ---- onboarding / external access (bootstrap wizard) ----
# Access provider for external DNS + TLS (manual | cloudflare).
SELFU_ACCESS_PROVIDER=manual
# Local domain served before onboarding (bootstrap admin lives under it).
SELFU_LOCAL_DOMAIN=selfu.local
# Origin IP published by DNS providers for platform hostnames.
SELFU_PUBLIC_IP=

# ---- production ingress (G9) ----
PLATFORM_HOST=platform.pruxi.in
AUTH_HOST=auth.pruxi.in
MAIL_HOST=mail.pruxi.in
ACME_EMAIL=admin@pruxi.in
PUBLIC_IP=127.0.0.1
# ---- values derived above - the compose stack uses these -
SELFU_OIDC_REDIRECT_URL=https://platform.pruxi.in/api/v1/auth/callback
SELFU_COOKIE_SECURE=true
SELFU_OIDC_TLS_INSECURE=false
AUTHENTIK_HOST=https://auth.pruxi.in
